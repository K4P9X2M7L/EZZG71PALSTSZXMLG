
--[[
    shitlib - updated UI library
    Original structure preserved.
]]

local Library = {}

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

local ACCENT = Color3.fromRGB(106, 90, 205)
local DARK = Color3.fromRGB(20, 20, 20)
local PANEL = Color3.fromRGB(22, 22, 22)
local ELEMENT = Color3.fromRGB(25, 25, 25)
local WHITE = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(145, 145, 145)

local function Create(class, properties, parent)
    local object = Instance.new(class)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 5)
    }, parent)
end

local function Tween(object, properties, duration)
    local tween = TS:Create(
        object,
        TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        properties
    )
    tween:Play()
    return tween
end

local function NewRow(parent, name, height)
    local frame = Create("Frame", {
        Name = name,
        BackgroundColor3 = ELEMENT,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 36)
    }, parent)

    Corner(frame, 5)
    return frame
end

local function NewText(parent, text, position, size, fontSize)
    return Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = position,
        Size = size,
        Font = Enum.Font.Gotham,
        Text = tostring(text),
        TextColor3 = WHITE,
        TextSize = fontSize or 13,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

local function FormatKey(key)
    if not key then
        return "NONE"
    end

    return key.Name
end

function Library:Create(name, subname, keybind)
    local old = game.CoreGui:FindFirstChild(name)
    if old then
        old:Destroy()
    end

    local ScreenGui = Create("ScreenGui", {
        Name = name,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false
    }, game.CoreGui)

    local Main = Create("Frame", {
        Name = "Main",
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 192, 0, 224),
        Size = UDim2.new(0, 645, 0, 366)
    }, ScreenGui)

    Corner(Main, 5)

    local Title = Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 7, 0, 0),
        Size = UDim2.new(0, 179, 0, 34),
        Font = Enum.Font.GothamBold,
        Text = name,
        TextColor3 = WHITE,
        TextSize = 24,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Main)

    local SubTitle = Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 7, 0, 34),
        Size = UDim2.new(0, 179, 0, 18),
        Font = Enum.Font.Gotham,
        Text = subname or "",
        TextColor3 = MUTED,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Main)

    local TabsHolder = Create("Frame", {
        Name = "TabsHolder",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 6, 0, 58),
        Size = UDim2.new(0, 179, 0, 302)
    }, Main)

    local TabLayout = Create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8)
    }, TabsHolder)

    local PageHolder = Create("Frame", {
        Name = "PageHolder",
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 192, 0, 7),
        Size = UDim2.new(0, 447, 0, 353)
    }, Main)

    Corner(PageHolder, 5)

    -- Window dragging

    local dragging = false
    local dragStart
    local startPosition

    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = Main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart

            Tween(Main, {
                Position = UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )
            }, 0.08)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Window visibility keybind

    local windowKey = keybind or Enum.KeyCode.RightShift

    UIS.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == windowKey then
            Main.Visible = not Main.Visible
        end
    end)

    local Window = {}

    function Window:tab(tabname, showonstartup)
        local Tab = Create("TextButton", {
            Name = "Tab",
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 29),
            Font = Enum.Font.Gotham,
            Text = tabname,
            TextColor3 = WHITE,
            TextSize = 14,
            TextTransparency = showonstartup and 0 or 0.5,
            AutoButtonColor = false
        }, TabsHolder)

        Corner(Tab, 5)

        local Page = Create("Frame", {
            Name = tabname,
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            Visible = showonstartup == true
        }, PageHolder)

        Corner(Page, 5)

        local Container = Create("ScrollingFrame", {
            Name = "PageContainer",
            Active = true,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 6, 0, 6),
            Size = UDim2.new(1, -12, 1, -12),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = ACCENT,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y
        }, Page)

        local Layout = Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8)
        }, Container)

        Tab.MouseButton1Click:Connect(function()
            for _, page in ipairs(PageHolder:GetChildren()) do
                if page:IsA("Frame") then
                    page.Visible = false
                end
            end

            for _, tab in ipairs(TabsHolder:GetChildren()) do
                if tab:IsA("TextButton") then
                    Tween(tab, {
                        TextTransparency = 0.5,
                        BackgroundColor3 = PANEL
                    })
                end
            end

            Page.Visible = true

            Tween(Tab, {
                TextTransparency = 0,
                BackgroundColor3 = Color3.fromRGB(32, 29, 48)
            })
        end)

        local Items = {}

        -- LABEL

        function Items:label(text)
            local Row = NewRow(Container, tostring(text), 34)

            local Label = NewText(
                Row,
                text,
                UDim2.new(0, 10, 0, 0),
                UDim2.new(1, -20, 1, 0),
                13
            )

            Label.TextColor3 = MUTED
            return Row
        end

        -- BUTTON

        function Items:button(text, callback)
            callback = callback or function() end

            local Row = NewRow(Container, tostring(text), 36)

            local Button = Create("TextButton", {
                Name = "Button",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -20, 1, 0),
                Font = Enum.Font.Gotham,
                Text = text,
                TextColor3 = WHITE,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false
            }, Row)

            Button.MouseButton1Click:Connect(function()
                Tween(Row, {
                    BackgroundColor3 = Color3.fromRGB(42, 38, 58)
                }, 0.1)

                task.delay(0.12, function()
                    if Row.Parent then
                        Tween(Row, {
                            BackgroundColor3 = ELEMENT
                        }, 0.2)
                    end
                end)

                pcall(callback)
            end)

            return Row
        end

        -- TOGGLE

        -- Usage:
        -- tab:toggle("Example", false, function(value) end)
        -- tab:toggle("Example", false, callback, Enum.KeyCode.F)

        function Items:toggle(text, state, callback, defaultKey)
            callback = callback or function() end

            local toggled = state == true
            local assignedKey = defaultKey

            local Row = NewRow(Container, tostring(text), 38)

            local Button = Create("TextButton", {
                Name = "Button",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(0.67, 0, 1, 0),
                Font = Enum.Font.Gotham,
                Text = text,
                TextColor3 = WHITE,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false
            }, Row)

            -- Keybind selector

            local KeyButton = Create("TextButton", {
                Name = "Keybind",
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                Position = UDim2.new(1, -105, 0.5, -11),
                Size = UDim2.new(0, 58, 0, 22),
                Font = Enum.Font.GothamMedium,
                Text = assignedKey and FormatKey(assignedKey) or "KEY",
                TextColor3 = MUTED,
                TextSize = 10,
                AutoButtonColor = false
            }, Row)

            Corner(KeyButton, 4)

            -- Diagonal toggle indicator

            local ToggleBackground = Create("Frame", {
                Name = "ToggleBackground",
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                Position = UDim2.new(1, -37, 0.5, -12),
                Size = UDim2.new(0, 25, 0, 24),
                Rotation = -10
            }, Row)

            Corner(ToggleBackground, 4)

            local ToggleIcon = Create("ImageLabel", {
                Name = "ToggleIcon",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 3, 0, 3),
                Size = UDim2.new(1, -6, 1, -6),
                Image = "rbxassetid://10449228819",
                ImageColor3 = ACCENT,
                ImageTransparency = toggled and 0 or 1,
                Rotation = 10
            }, ToggleBackground)

            local function SetToggle(value, silent)
                toggled = value == true

                Tween(ToggleBackground, {
                    BackgroundColor3 = toggled
                        and Color3.fromRGB(45, 38, 72)
                        or PANEL
                })

                Tween(ToggleIcon, {
                    ImageTransparency = toggled and 0 or 1
                })

                if not silent then
                    pcall(callback, toggled)
                end
            end

            Button.MouseButton1Click:Connect(function()
                SetToggle(not toggled)
            end)

            -- Key assignment mode

            local listening = false

            KeyButton.MouseButton1Click:Connect(function()
                listening = true
                KeyButton.Text = "PRESS..."
                KeyButton.TextColor3 = ACCENT
            end)

            local keyConnection

            keyConnection = UIS.InputBegan:Connect(function(input, processed)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then
                    return
                end

                if listening then
                    listening = false

                    if input.KeyCode == Enum.KeyCode.Escape then
                        KeyButton.Text = assignedKey and FormatKey(assignedKey) or "KEY"
                        KeyButton.TextColor3 = MUTED
                        return
                    end

                    assignedKey = input.KeyCode
                    KeyButton.Text = FormatKey(assignedKey)
                    KeyButton.TextColor3 = WHITE
                    return
                end

                if processed then
                    return
                end

                if assignedKey and input.KeyCode == assignedKey then
                    SetToggle(not toggled)
                end
            end)

            local controller = {}

            function controller:Set(value)
                SetToggle(value)
            end

            function controller:Get()
                return toggled
            end

            function controller:SetKey(key)
                assignedKey = key
                KeyButton.Text = FormatKey(key)
            end

            function controller:GetKey()
                return assignedKey
            end

            function controller:Destroy()
                if keyConnection then
                    keyConnection:Disconnect()
                end
                Row:Destroy()
            end

            return controller
        end

        -- STANDALONE KEYBIND

        -- Usage:
        -- tab:keybind("Fly", Enum.KeyCode.F, function() end)

        function Items:keybind(text, defaultKey, callback)
            callback = callback or function() end

            local assignedKey = defaultKey
            local listening = false

            local Row = NewRow(Container, tostring(text), 38)

            NewText(
                Row,
                text,
                UDim2.new(0, 10, 0, 0),
                UDim2.new(0.65, 0, 1, 0),
                13
            )

            local KeyButton = Create("TextButton", {
                Name = "Keybind",
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                Position = UDim2.new(1, -100, 0.5, -11),
                Size = UDim2.new(0, 90, 0, 22),
                Font = Enum.Font.GothamMedium,
                Text = FormatKey(assignedKey),
                TextColor3 = WHITE,
                TextSize = 11,
                AutoButtonColor = false
            }, Row)

            Corner(KeyButton, 4)

            KeyButton.MouseButton1Click:Connect(function()
                listening = true
                KeyButton.Text = "PRESS KEY..."
                KeyButton.TextColor3 = ACCENT
            end)

            local connection

            connection = UIS.InputBegan:Connect(function(input, processed)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then
                    return
                end

                if listening then
                    listening = false

                    if input.KeyCode == Enum.KeyCode.Escape then
                        KeyButton.Text = FormatKey(assignedKey)
                        KeyButton.TextColor3 = WHITE
                        return
                    end

                    assignedKey = input.KeyCode
                    KeyButton.Text = FormatKey(assignedKey)
                    KeyButton.TextColor3 = WHITE
                    return
                end

                if not processed and assignedKey and input.KeyCode == assignedKey then
                    pcall(callback, input.KeyCode)
                end
            end)

            local controller = {}

            function controller:SetKey(key)
                assignedKey = key
                KeyButton.Text = FormatKey(key)
            end

            function controller:GetKey()
                return assignedKey
            end

            function controller:Destroy()
                connection:Disconnect()
                Row:Destroy()
            end

            return controller
        end

        -- HALF CIRCLE GRADIENT SLIDER

        -- Usage:
        -- tab:slider("Speed", 0, 100, 50, function(value) end)

        function Items:slider(text, minimum, maximum, default, callback)
            minimum = tonumber(minimum) or 0
            maximum = tonumber(maximum) or 100
            default = tonumber(default) or minimum
            callback = callback or function() end

            if maximum <= minimum then
                maximum = minimum + 1
            end

            local value = math.clamp(default, minimum, maximum)
            local percent = (value - minimum) / (maximum - minimum)

            local Row = NewRow(Container, tostring(text), 112)

            NewText(
                Row,
                text,
                UDim2.new(0, 10, 0, 4),
                UDim2.new(0.7, 0, 0, 22),
                13
            )

            local ValueLabel = Create("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -75, 0, 4),
                Size = UDim2.new(0, 65, 0, 22),
                Font = Enum.Font.GothamMedium,
                Text = tostring(value),
                TextColor3 = ACCENT,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right
            }, Row)

            -- Semicircle visual

            local Gauge = Create("Frame", {
                Name = "Gauge",
                BackgroundTransparency = 1,
                Position = UDim2.new(0.5, -72, 0, 26),
                Size = UDim2.new(0, 144, 0, 76),
                ClipsDescendants = false
            }, Row)

            -- Asset-based semicircle arc

            local Arc = Create("ImageLabel", {
                Name = "Arc",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(1, 0, 0, 144),
                Image = "rbxassetid://13814723643",
                ImageColor3 = WHITE,
                ScaleType = Enum.ScaleType.Fit
            }, Gauge)

            local ArcGradient = Create("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(75, 65, 140)),
                    ColorSequenceKeypoint.new(0.5, ACCENT),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 140, 255))
                }),
                Rotation = 0
            }, Arc)

            -- Track and gradient progress segments

            local segments = {}
            local segmentCount =  thirty or 36

            for i = 1, segmentCount do
                local angle = math.pi - ((i - 1) / (segmentCount - 1)) * math.pi

                local x = 72 + math.cos(angle) * 59
                local y = 69 - math.sin(angle) * 59

                local segment = Create("Frame", {
                    Name = "Segment_" .. i,
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0, x, 0, y),
                    Size = UDim2.new(0, 4, 0, 4),
                    BackgroundColor3 = Color3.fromRGB(55, 52, 64),
                    BorderSizePixel = 0,
                    Rotation = -math.deg(angle)
                }, Gauge)

                Corner(segment, 5)
                segments[i] = segment
            end

            -- Center indicator

            local Needle = Create("Frame", {
                Name = "Needle",
                AnchorPoint = Vector2.new(0.5, 1),
                Position = UDim2.new(0.5, 0, 0, 69),
                Size = UDim2.new(0, 3, 0, 43),
                BackgroundColor3 = WHITE,
                BorderSizePixel = 0,
                Rotation = -90 + percent * 180
            }, Gauge)

            Corner(Needle, 3)

            local Center = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0, 69),
                Size = UDim2.new(0, 10, 0, 10),
                BackgroundColor3 = ACCENT,
                BorderSizePixel = 0
            }, Gauge)

            Corner(Center, 10)

            local SliderButton = Create("TextButton", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                AutoButtonColor = false,
                ZIndex = 10
            }, Gauge)

            local draggingSlider = false

            local function UpdateVisual()
                percent = (value - minimum) / (maximum - minimum)

                ValueLabel.Text = tostring(math.floor(value * 100 + 0.5) / 100)

                Tween(Needle, {
                    Rotation = -90 + percent * 180
                }, 0.12)

                for i, segment in ipairs(segments) do
                    local active = (i - 1) / (segmentCount - 1) <= percent

                    local hue = 0.72 - ((i - 1) / (segmentCount - 1)) * 0.13

                    Tween(segment, {
                        BackgroundColor3 = active
                            and Color3.fromHSV(hue, 0.55, 1)
                            or Color3.fromRGB(55, 52, 64)
                    }, 0.12)
                end
            end

            local function SetValue(newValue, silent)
                value = math.clamp(newValue, minimum, maximum)
                value = math.floor(value * 100 + 0.5) / 100

                UpdateVisual()

                if not silent then
                    pcall(callback, value)
                end
            end

            local function UpdateFromInput(input)
                local position = input.Position
                local absolute = Gauge.AbsolutePosition
                local size = Gauge.AbsoluteSize

                local relativeX = math.clamp(
                    (position.X - absolute.X) / size.X,
                    0,
                    1
                )

                -- Left side = minimum, right side = maximum.
                SetValue(minimum + relativeX * (maximum - minimum))
            end

            SliderButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = true
                    UpdateFromInput(input)
                end
            end)

            UIS.InputChanged:Connect(function(input)
                if draggingSlider and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    UpdateFromInput(input)
                end
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = false
                end
            end)

            UpdateVisual()

            local controller = {}

            function controller:Set(newValue)
                SetValue(newValue)
            end

            function controller:Get()
                return value
            end

            function controller:Destroy()
                Row:Destroy()
            end

            return controller
        end

        return Items
    end

    return Window
end

return Library
