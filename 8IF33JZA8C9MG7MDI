                    if input.KeyCode == Enum.KeyCode.DPadRight then HSV[1] = math.clamp(HSV[1] + 0.01, 0, 1); changed = true end
                elseif selected == AlphaSlider.Track then
                    if input.KeyCode == Enum.KeyCode.DPadLeft then CurrentAlpha = math.clamp(CurrentAlpha - 0.01, 0, 1); changed = true end
                    if input.KeyCode == Enum.KeyCode.DPadRight then CurrentAlpha = math.clamp(CurrentAlpha + 0.01, 0, 1); changed = true end
